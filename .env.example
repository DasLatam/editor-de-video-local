# Configuración del editor. Copiá este archivo a .env y ajustalo; run.sh lo lee.

# Dirección y puerto del servidor. Sin login: 127.0.0.1 = sólo esta máquina,
# 0.0.0.0 = toda la red local (no lo expongas a internet).
HOST=127.0.0.1
PORT=8088

# Dónde se guardan subidas, exports, miniaturas y la base SQLite.
# Ruta absoluta o relativa a backend/. Los videos ocupan mucho: elegí un disco grande.
STORAGE_PATH=storage
# DATABASE_URL=sqlite:////ruta/absoluta/editor.db

# Marca (logo de la placa de cierre y marca de agua de la esquina, PNG con
# transparencia). Si no existen, esas dos opciones del export no hacen nada.
BRAND_NAME="Editor de video"   # entre comillas si lleva espacios
# BRAND_LOGO=/ruta/a/logo.png
# BRAND_WATERMARK=/ruta/a/marca-de-agua.png

# FFmpeg a usar. Vacío = el primero del sistema que tenga libass (subtítulos).
# FFMPEG_BIN=/usr/bin/ffmpeg

# Modelos de Whisper (se bajan solos la primera vez que transcribís, ~500 MB
# el "small"). Por defecto en ~/.cache/huggingface.
# HF_HOME=/ruta/a/cache
